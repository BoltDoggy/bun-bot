# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Bun
bun.lockb

# OS / editor
.DS_Store
.idea/
.vscode/

# Agent 跨会话记忆（每次会话都会变更，产生噪音，仅本地持久化）
AGENT_STATE.json
MEMORY.md
# 会话级 checkpoint（--resume 断点续跑的消息历史，任务完成即清除）
AGENT_CHECKPOINT.json
# P3-4 审计日志（每次工具调用入参/出参摘要，持续追加，仅本地持久化）
AUDIT.log.jsonl

# P4-4：状态目录（AGENT_STATE / MEMORY / CHECKPOINT / AUDIT 移入 .bunbot/，gitignore 自动追加）
.bunbot/
